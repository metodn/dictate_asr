#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx>=0.27"]
# ///
"""Streaming dictation straight against llama-swap (no adapter server).

  claude-dictate-ws record   mic -> repeated decodes of the growing audio, prints JSON lines:
                             {"t":"p","text":..} interim, {"t":"f","text":..} final, {"t":"e","text":..} error,
                             {"t":"s","text":..} server status (fallback in use)
  claude-dictate-ws stop     finish the running recording (SIGTERM)
  claude-dictate-ws info | help | use <name> | add <name> <host[:port]|url> [model] [key=<token>] | remove <name> | warm

Servers live in ~/.config/claude-dictate/servers.json (mode 600, may hold API keys):
  {"active": "local", "servers": [{"name": "local", "url": "http://localhost:8181", "model": "lfm3-audio-2b", "apiKey": "..."}]}
The active server is tried first; if it fails the others are tried in order.
Env: SWAP / ASR_MODEL / ASR_API_KEY (one server "env" that replaces the file), ASR_LANG (unset = auto),
     STEP_SEC (1.0), SEG_SEC (40, longer audio is committed in segments), MAX_SECS (120)
"""
import asyncio, base64, json, os, re, signal, struct, sys
from pathlib import Path

LANG = os.environ.get("ASR_LANG", "")
STEP = float(os.environ.get("STEP_SEC", "1.0"))
SEG = float(os.environ.get("SEG_SEC", "40"))
MAX = float(os.environ.get("MAX_SECS", "120"))
CFG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "claude-dictate" / "servers.json"
DEFAULT_MODEL = "lfm3-audio-2b"


def load_cfg() -> dict:
    if os.environ.get("SWAP"):
        srv = {"name": "env", "url": os.environ["SWAP"].rstrip("/"), "model": os.environ.get("ASR_MODEL", DEFAULT_MODEL)}
        if os.environ.get("ASR_API_KEY"):
            srv["apiKey"] = os.environ["ASR_API_KEY"]
        return {"active": "env", "servers": [srv]}
    try:
        c = json.loads(CFG.read_text())
        if c.get("servers"):
            if c.get("active") not in [x["name"] for x in c["servers"]]:
                c["active"] = c["servers"][0]["name"]
            return c
    except Exception:
        pass
    return {"active": "local", "servers": [{"name": "local", "url": "http://localhost:8181", "model": os.environ.get("ASR_MODEL", DEFAULT_MODEL)}]}


def save_cfg(c: dict) -> None:
    CFG.parent.mkdir(parents=True, exist_ok=True)
    CFG.write_text(json.dumps(c, indent=2) + "\n")
    CFG.chmod(0o600)


def ordered(c: dict) -> list[dict]:
    """Active server first, the rest as fallbacks."""
    return sorted(c["servers"], key=lambda x: x["name"] != c["active"])


def auth(srv: dict) -> dict:
    return {"Authorization": f"Bearer {srv['apiKey']}"} if srv.get("apiKey") else {}


RATE, BPS = 16000, 32000  # sample rate, bytes per second
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "claude-dictate"
PIDF = RUN / "pid"


def emit(t: str, text: str = "") -> None:
    print(json.dumps({"t": t, "text": text}, ensure_ascii=False), flush=True)


def clean(t: str) -> str:
    return re.sub(r"<_*media_*>", "", t).strip()


def trim_silence(pcm: bytes) -> bytes:
    """Drop leading silence (the model invents phrases from room noise); b'' if all quiet."""
    from array import array
    win = 3200  # 100 ms of s16le bytes
    for i in range(0, len(pcm) - win + 1, win):
        a = array("h", pcm[i:i + win])
        if (sum(x * x for x in a) / len(a)) ** 0.5 > 260:   # ~0.008 of full scale
            return pcm[max(0, i - 3 * win):]
    return b""


def wav(pcm: bytes) -> bytes:
    n = len(pcm)
    return b"".join([b"RIFF", struct.pack("<I", 36 + n), b"WAVE", b"fmt ",
                     struct.pack("<IHHIIHH", 16, 1, 1, RATE, RATE * 2, 2, 16),
                     b"data", struct.pack("<I", n), pcm])


async def decode_one(client, srv: dict, pcm: bytes) -> str:
    system = f"Perform ASR in {LANG}." if LANG else "Perform ASR."
    r = await client.post(f"{srv['url']}/v1/chat/completions", timeout=120.0, headers=auth(srv), json={
        "model": srv["model"], "temperature": 0, "max_tokens": 1024,
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": [{"type": "input_audio", "input_audio": {
                "data": base64.b64encode(wav(pcm)).decode(), "format": "wav"}}]},
        ]})
    r.raise_for_status()
    return clean(r.json()["choices"][0]["message"]["content"] or "")


_used = ""


async def decode(client, pcm: bytes) -> str:
    """Try the active server, then the fallbacks; raise only when every one failed."""
    global _used
    cfg = load_cfg()
    errs = []
    for srv in ordered(cfg):
        try:
            text = await decode_one(client, srv, pcm)
        except Exception as exc:
            code = getattr(getattr(exc, "response", None), "status_code", None)
            why = "API key rejected" if code in (401, 403) else f"HTTP {code}" if code else type(exc).__name__
            errs.append(f"{srv['name']} ({srv['url']}): {why}")
            continue
        if srv["name"] != _used:
            _used = srv["name"]
            emit("s", f"asr: {srv['name']}" + (f" (fallback, {cfg['active']} failed)" if srv["name"] != cfg["active"] else ""))
        return text
    raise RuntimeError("all servers failed: " + "; ".join(errs))


async def record() -> int:
    import httpx

    RUN.mkdir(parents=True, exist_ok=True)
    if PIDF.exists():
        try:
            os.kill(int(PIDF.read_text()), 0)
            emit("e", "already recording")
            return 1
        except (ProcessLookupError, ValueError):
            pass
    PIDF.write_text(str(os.getpid()))
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, stop.set)

    buf = bytearray()
    committed: list[str] = []   # finished segments
    seg_start = 0               # byte offset where the current segment begins
    seg_text = ""               # latest decode of the current segment
    decoded_len = 0             # len(buf) at the last decode
    last_shown = ""

    rec = await asyncio.create_subprocess_exec(
        "parecord", "--raw", "--latency-msec=30", "--channels=1", "--rate=16000", "--format=s16le",
        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)

    async def pump() -> None:
        while chunk := await rec.stdout.read(3200):
            buf.extend(chunk)

    def full() -> str:
        return " ".join(t for t in committed + [seg_text] if t)

    async def decode_now(client, final: bool) -> None:
        nonlocal seg_text, seg_start, decoded_len, last_shown
        n = len(buf)
        voiced = trim_silence(bytes(buf[seg_start:n]))
        text = await decode(client, voiced) if len(voiced) >= 0.3 * BPS else ""
        seg_text, decoded_len = text, n
        if n - seg_start > SEG * BPS:   # long speech: commit this segment, start a new one
            committed.append(seg_text)
            seg_text, seg_start = "", n
        shown = full()
        if not final and shown and shown != last_shown:
            last_shown = shown
            emit("p", shown)

    ptask = asyncio.create_task(pump())
    try:
        async with httpx.AsyncClient() as client:
            started = loop.time()
            while not stop.is_set() and loop.time() - started < MAX:
                await asyncio.sleep(0.2)
                new = len(buf) - decoded_len
                if new >= STEP * BPS and len(buf) - seg_start >= 0.4 * BPS:
                    await decode_now(client, False)  # one at a time: awaited here
            if rec.returncode is None:
                rec.terminate()
            await ptask
            if len(buf) - decoded_len > 0.15 * BPS and len(buf) - seg_start >= 0.4 * BPS:
                await decode_now(client, True)       # audio after the last decode
            emit("f", full())
        return 0
    except Exception as exc:  # llama-swap down, HTTP error, ...
        emit("e", str(exc) if isinstance(exc, RuntimeError) else f"{type(exc).__name__}: {exc}")
        return 1
    finally:
        if rec.returncode is None:
            rec.terminate()
        PIDF.unlink(missing_ok=True)


def probe(srv: dict) -> str:
    import urllib.request, urllib.error
    try:
        req = urllib.request.Request(f"{srv['url']}/v1/models", headers=auth(srv))
        with urllib.request.urlopen(req, timeout=2.5) as r:
            ids = [m.get("id") for m in json.loads(r.read().decode()).get("data", [])]
        return "ready" if srv["model"] in ids else "model not listed"
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            return "API key rejected" if srv.get("apiKey") else "needs an API key"
        return "no models API yet"
    except Exception:
        return "down"


def report() -> str:
    cfg = load_cfg()
    rows = [(f"{'*' if x['name'] == cfg['active'] else ' '} {x['name']:<8} {x['url']}  {x['model']}"
             f"{'  (key)' if x.get('apiKey') else ''}  [{probe(x)}]", f"/dictate use {x['name']}") for x in cfg["servers"]]
    w = max(len(r[0]) for r in rows)
    return "\n".join(f"{a:<{w}}  |  {b}" for a, b in rows)


HELP = """dictation (claude-dictate)
  /dictate               switch Space-hold dictation on or off (turns built-in /voice off/on)
  Hold Space             speak while held, release to finish (after /dictate)
  /dictate rec           hands-free: start recording; run /dictate rec again to finish
  /dictate where start|caret|end   where the words go in the draft
  /dictate info          state and servers, with [ready] / [down]
  /dictate use <name>    choose the server tried first; the others are fallbacks
  /dictate add <name> <host[:port]|url> [model] [key=<API key>]    /dictate remove <name>
  A server behind an API key: add key=<token> (saved in ~/.config/claude-dictate/servers.json, mode 600).
  Audio is recorded locally with parecord and sent only to the configured servers.
  No sound or only silence: check parecord and the microphone."""


def info_cmd() -> int:
    """Where the voice goes, and whether that server is up. Starts nothing."""
    print(f"servers (* = active):\n{report()}")
    print(f"language:     {LANG or 'auto-detect'}")
    print(f"recording:    {'yes' if PIDF.exists() else 'no'}")
    return 0


def manage(cmd: str, args: list[str]) -> int:
    cfg = load_cfg()
    names = [x["name"] for x in cfg["servers"]]
    name = args[0] if args else ""
    if os.environ.get("SWAP") and cmd in ("use", "add", "remove"):
        print("SWAP is set in the environment and overrides the server file; unset it to manage servers.")
        return 1
    if cmd == "use":
        if name not in names:
            print(f'asr: no server "{name}". Known: {", ".join(names)}')
            return 1
        cfg["active"] = name
        save_cfg(cfg)
        print(f"asr: using {name}")
    elif cmd == "add":
        if len(args) < 2:
            print("usage: /dictate add <name> <host[:port]|url> [model] [key=<API key>]")
            return 1
        rest = args[2:]
        model = next((t for t in rest if not t.startswith("key=")), DEFAULT_MODEL)
        key = next((t[4:] for t in rest if t.startswith("key=")), None)
        url = (args[1] if re.match(r"https?://", args[1]) else f"http://{args[1]}").rstrip("/")
        old = next((x for x in cfg["servers"] if x["name"] == name), None)
        key = key or (old or {}).get("apiKey")        # re-adding keeps the saved key
        entry = {"name": name, "url": url, "model": model, **({"apiKey": key} if key else {})}
        cfg["servers"] = [entry if x["name"] == name else x for x in cfg["servers"]] if old else cfg["servers"] + [entry]
        save_cfg(cfg)
        print(f"asr: {'updated' if old else 'added'} {name} ({url}, {model})\n{report()}")
    elif cmd == "remove":
        if len(names) < 2 or name not in names:
            print(f'asr: cannot remove "{name}" (unknown, or the only server)')
            return 1
        cfg["servers"] = [x for x in cfg["servers"] if x["name"] != name]
        if cfg["active"] == name:
            cfg["active"] = cfg["servers"][0]["name"]
        save_cfg(cfg)
        print(f"asr: removed {name}; active: {cfg['active']}")
    return 0


def warm_cmd() -> int:
    """Ask the active server to load the ASR model while the person speaks."""
    import urllib.request
    cfg = load_cfg()
    srv = ordered(cfg)[0]
    try:
        urllib.request.urlopen(urllib.request.Request(f"{srv['url']}/upstream/{srv['model']}/health", headers=auth(srv)), timeout=30).read()
    except Exception:
        pass
    return 0


def stop_cmd() -> int:
    try:
        os.kill(int(PIDF.read_text()), signal.SIGTERM)
        return 0
    except (FileNotFoundError, ProcessLookupError, ValueError):
        print("not recording", file=sys.stderr)
        return 1


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "record":
        sys.exit(asyncio.run(record()))
    if cmd == "stop":
        sys.exit(stop_cmd())
    if cmd == "info":
        sys.exit(info_cmd())
    if cmd == "help":
        print(HELP)
        sys.exit(0)
    if cmd == "warm":
        sys.exit(warm_cmd())
    if cmd in ("use", "add", "remove"):
        sys.exit(manage(cmd, sys.argv[2:]))
    sys.exit(2)
